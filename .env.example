# -----------------------------------------------------------------------------
# 애플리케이션
# - NODE_ENV: 실행 환경(development, production, test)
# - APP_NAME: 로그/메트릭에 표시할 애플리케이션 이름
# - APP_PORT: 앱 컨테이너/프로세스가 바인딩하는 내부 포트
# - APP_HOST_PORT: docker compose가 호스트에 노출하는 외부 포트
# - APP_SHUTDOWN_TIMEOUT_MS: graceful shutdown 시 in-flight 요청 대기 한도(ms)
#   ⚠ k8s의 terminationGracePeriodSeconds가 이 값보다 커야 한다
# - APP_SWAGGER_ENABLED: Swagger 문서 노출 여부
# - APP_SWAGGER_PATH: Swagger UI 경로
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=barebones
APP_PORT=3000
APP_HOST_PORT=3000
APP_SHUTDOWN_TIMEOUT_MS=10000
APP_SWAGGER_ENABLED=true
APP_SWAGGER_PATH=docs

# -----------------------------------------------------------------------------
# 프록시
# - TRUST_PROXY_HOPS: 신뢰할 프록시 홉 수. 0 = 프록시 없음(로컬 기본값)
#   ALB 하나만 앞에 있으면 1, CloudFront까지 얹으면 2.
#   설정하지 않으면 req.ip가 프록시 IP가 되어 rate limit이 **전 사용자 공용 버킷**이 된다.
#   ⚠ "전부 신뢰"는 지원하지 않는다 — 클라이언트가 X-Forwarded-For를 위조해 우회할 수 있다.
# -----------------------------------------------------------------------------
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# CORS
# - CORS_ENABLED: CORS 활성화 여부
# - CORS_ORIGINS: 허용 origin 목록(쉼표 구분). '*'는 전체 허용이며 production에서는 금지
# - CORS_CREDENTIALS: 쿠키/Authorization 헤더 동반 요청 허용 여부
# -----------------------------------------------------------------------------
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# 로깅
# - LOG_LEVEL: trace, debug, info, warn, error, fatal
# - LOG_LOKI_ENABLED: Loki 전송 여부
# - LOG_STDOUT_ENABLED: 표준 출력 로그 표시 여부
# - LOKI_HOST: 로컬 `yarn start:dev` 실행 시 사용할 Loki 주소
# - DOCKER_LOKI_HOST: Docker 네트워크 내부에서 사용할 Loki 주소
# - LOKI_HOST_PORT: 호스트에서 Loki에 접속할 포트
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_LOKI_ENABLED=true
LOG_STDOUT_ENABLED=true
LOKI_HOST=http://localhost:3100
DOCKER_LOKI_HOST=http://loki:3100
LOKI_HOST_PORT=3100

# -----------------------------------------------------------------------------
# HTTP / 헬스체크
# - THROTTLE_TTL: 요청 제한 기간(ms)
# - THROTTLE_LIMIT: 제한 기간 내 허용 요청 수
# - HEALTH_MEMORY_HEAP_THRESHOLD: 메모리 헬스체크 임계값(bytes)
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
HEALTH_MEMORY_HEAP_THRESHOLD=536870912

# -----------------------------------------------------------------------------
# Redis / Cache / BullMQ
# - REDIS_ENABLED: Redis 기능 사용 여부
# - REDIS_HOST: 로컬 `yarn start:dev` 실행 시 사용할 Redis 호스트
# - DOCKER_REDIS_HOST: Docker 네트워크 내부에서 사용할 Redis 호스트
# - REDIS_HOST_PORT: 호스트에서 Redis에 접속할 포트
# - CACHE_TTL: 기본 캐시 TTL(ms)
# - BULLMQ_ENABLED: BullMQ 사용 여부
# - BULLMQ_PREFIX: BullMQ 키 prefix
# -----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
DOCKER_REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=app:
CACHE_TTL=60000
BULLMQ_ENABLED=true
BULLMQ_PREFIX=app

# -----------------------------------------------------------------------------
# Prometheus
# - PROMETHEUS_ENABLED: Prometheus 메트릭 노출 여부
# - 메트릭 prefix / scrape path / dashboard query는 `config/observability.config.json`에서 관리
# - PROMETHEUS_HOST_PORT: 호스트에서 Prometheus에 접속할 포트
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_HOST_PORT=9090

# -----------------------------------------------------------------------------
# MongoDB (NoSQL document store)
MONGODB_ENABLED=true
MONGODB_URI=
MONGODB_HOST=localhost
DOCKER_MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_HOST_PORT=27017
MONGODB_USERNAME=app
MONGODB_PASSWORD=app
MONGODB_DATABASE=app
MONGODB_AUTH_SOURCE=admin

# -----------------------------------------------------------------------------
# 데이터베이스
# - DB_TYPE: postgres(기본) / mysql / mariadb
#   DB를 바꾸려면 이 값과 드라이버 패키지만 바꾸면 된다 — 코드는 그대로다.
#   ORM 자체를 바꾸는 것은 src/common/persistence/의 어댑터를 교체하는 일이다.
# - DB_HOST: 로컬 `yarn start:dev` 실행 시 사용할 DB 호스트
# - DOCKER_DB_HOST: Docker 네트워크 내부에서 사용할 DB 호스트
# - DB_HOST_PORT: 호스트에서 DB에 접속할 포트
# - DB_SCHEMA: 사용할 스키마 (postgres 전용)
# - DB_LOGGING: TypeORM 쿼리 로그 출력 여부
# - DB_SSL: 관리형 DB(RDS 등) 접속 시 true
# - DB_SSL_CA: CA 인증서 PEM 내용. 주면 인증서 검증을 켠 채로 붙을 수 있다
#   (RDS는 CA 번들을 공개한다 — rds-ca-rsa2048-g1 등)
# - DB_SSL_REJECT_UNAUTHORIZED: 기본 true. false는 TLS의 **신원 확인을 끈다** —
#   암호화는 되지만 중간자를 구분할 수 없어 DB 비밀번호와 모든 쿼리가 평문으로 읽힌다.
#   그런데도 "작동은 하므로" 눈치채기 어렵다. production에서는 부팅이 거부된다.
# -----------------------------------------------------------------------------
DB_TYPE=postgres
DB_HOST=localhost
DOCKER_DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5432
DB_USERNAME=app
DB_PASSWORD=app
DB_DATABASE=app
DB_SCHEMA=public
DB_LOGGING=false
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# Grafana / Loki
# - GRAFANA_HOST_PORT: 호스트에서 Grafana에 접속할 포트
# - GRAFANA_ADMIN_USER: Grafana 초기 관리자 아이디
# - GRAFANA_ADMIN_PASSWORD: Grafana 초기 관리자 비밀번호
# -----------------------------------------------------------------------------
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
