NODE_ENV=development
APP_NAME=barebones-admin
APP_PORT=3000
APP_SWAGGER_PATH=admin/docs
LOG_LEVEL=debug
LOG_LOKI_ENABLED=true
LOG_STDOUT_ENABLED=true
LOKI_HOST=http://loki:3100
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
HEALTH_MEMORY_HEAP_THRESHOLD=536870912
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=barebones:
CACHE_TTL=60000
BULLMQ_ENABLED=true
BULLMQ_PREFIX=barebones
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=admin/metrics
PROMETHEUS_METRIC_PREFIX=barebones_
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_USERNAME=barebones
DB_PASSWORD=barebones
DB_DATABASE=barebones
DB_LOGGING=false
