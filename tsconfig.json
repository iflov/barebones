{
  "compilerOptions": {
    "module": "NodeNext",
    // NestJS 12 packages are ESM while this application remains CommonJS.
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "scripts/**/*",
    "drizzle.config.ts",
    "prisma.config.ts",
    "vitest.config.mts",
    "vitest.config.e2e.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
