{
  "compilerOptions": {
    "module": "NodeNext",
    // NodeNext(하이브리드 module kind)에서 ts-jest가 요구한다. 없으면 TS151002 경고.
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "drizzle.config.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
